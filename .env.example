# 复制为 .env 并填入真实值。生成随机秘密：openssl rand -hex 32（或 python -c "import secrets;print(secrets.token_hex(32))"）

# ── 必填秘密（缺失时后端与 compose 拒绝启动）──
# ≥32 位随机值，用于签发登录 JWT；更换后所有已登录会话失效
JWT_SECRET=replace-with-a-long-random-secret
# 后端调用 Agent 服务的内部令牌；≥32 位随机值，两侧必须一致
AGENT_SERVICE_TOKEN=replace-with-an-internal-agent-token
# compose 基础设施口令（仅 docker compose 部署需要）
POSTGRES_PASSWORD=replace-with-a-strong-db-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

JWT_TTL_SECONDS=28800

# ── LLM 供应商（OpenAI 兼容 /chat/completions，可同时配置多个）──
# GLM（TokenRhythm），默认优先使用；不配置任何 Key 时问答走规则兜底
GLM_API_KEY=
GLM_BASE_URL=https://tokenrhythm.studio/v1
GLM_MODEL=glm-5.3-flash
# DeepSeek（备用供应商）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 默认供应商：留空时按 GLM > DeepSeek 自动选择
LLM_PROVIDER=
LLM_TIMEOUT_SECONDS=60
# 向量检索（可选）：配置后启用 pgvector 混合检索；需供应商支持 /embeddings 与 dimensions 参数
AGENT_EMBED_MODEL=
AGENT_EMBED_DIMENSIONS=512

# ── 可选 ──
# 反向代理终结 TLS 时，登录 Cookie 强制 Secure
SECURITY_COOKIE_SECURE=
# 宿主机映射端口（默认后端只绑定 127.0.0.1）
BACKEND_HOST_PORT=127.0.0.1:8080
FRONTEND_HOST_PORT=5173
